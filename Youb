-- 5) Rainbow spinning plus
table.insert(Crosshairs, {
	Name = "Rainbow Plus",
	Build = function(holder)
		local parts = {
			bar(holder, 0, -8, 2, 10, Color3.new(1, 1, 1)),
			bar(holder, 0, 8, 2, 10, Color3.new(1, 1, 1)),
			bar(holder, -8, 0, 10, 2, Color3.new(1, 1, 1)),
