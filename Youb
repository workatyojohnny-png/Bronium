-- 6) Pink Diamond: the square spins fast (Circular easing), waits 2s, repeats
table.insert(Crosshairs, {
	Name = "Pink Diamond",
	Build = function(holder)
		local PINK = Color3.fromRGB(255, 105, 180)
		local SPIN_TIME = 0.7 -- how long the fast spin lasts
		local PAUSE_TIME = 2 -- wait before spinning again
		local TURNS = 2 -- full rotations per spin

		local glow = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Rotation = 45,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		})
		local glowStroke = stroke(PINK, 4, 0.78)
		glowStroke.Parent = glow

		local square = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(14, 14),
			Rotation = 45,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		})
		stroke(PINK, 2, 0).Parent = square

		-- the center point stays still
		dot(holder, 3, PINK)

		local start = os.clock()
		local cycle = PAUSE_TIME + SPIN_TIME

		return function()
			local t = (os.clock() - start) % cycle
			local rot = 45
			local spinning = false

			if t >= PAUSE_TIME then
				spinning = true
				local alpha = (t - PAUSE_TIME) / SPIN_TIME
				local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut)
				rot = 45 + eased * 360 * TURNS
			end

			square.Rotation = rot
			glow.Rotation = rot
			glowStroke.Transparency = spinning and 0.5 or 0.78
		end
	end,
})

-- 7) Spinning maroon crosshair (4 arrows pointing in, constant spin + motion blur)
table.insert(Crosshairs, {
	Name = "Spinning Maroon Crosshair",
	Build = function(holder)
		local MAROON = Color3.fromRGB(140, 0, 35)
		local SPEED = 300 -- degrees per second ("a little bit fast")
		local BLUR_STEP = 7 -- degrees each ghost trails behind the last

		-- builds one rotor: 4 arrows pointing toward the center
		local function buildRotor(transparency, zIndex)
			local rotor = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(50, 50),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = zIndex,
				Parent = holder,
			})

			for k = 0, 3 do
				local arm = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromScale(1, 1),
					Rotation = k * 90,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = zIndex,
					Parent = rotor,
				})

				local shaft = bar(arm, 0, -14, 2, 14, MAROON) -- arrow shaft
				local headL = bar(arm, -2.5, -9, 2, 7, MAROON) -- arrow head
				local headR = bar(arm, 2.5, -9, 2, 7, MAROON)
				headL.Rotation = -45
				headR.Rotation = 45

				for _, part in ipairs({ shaft, headL, headR }) do
					part.BackgroundTransparency = transparency
					part.ZIndex = zIndex
				end
			end
			return rotor
		end

		-- motion blur = faded ghost copies trailing behind the main arrows
		local ghostAlphas = { 0.6, 0.75, 0.85, 0.92 }
		local ghosts = {}
		for i, a in ipairs(ghostAlphas) do
			ghosts[i] = buildRotor(a, 1)
		end
		local main = buildRotor(0, 2)

		dot(holder, 3, MAROON).ZIndex = 3

		return function(elapsed)
			local rot = (elapsed * SPEED) % 360
			main.Rotation = rot
			for i, ghost in ipairs(ghosts) do
				ghost.Rotation = rot - i * BLUR_STEP
			end
		end
	end,
})

----------------------------------------------------------------
-- Mounting + animation loop
----------------------------------------------------------------
local updaters = {}
local startTime = os.clock()

RunService.RenderStepped:Connect(function()
	local elapsed = os.clock() - startTime
	for _, fn in pairs(updaters) do
		fn(elapsed)
	end
end)

local function mount(def, parent)
	local holder = make("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	if def.Build then
		local update = def.Build(holder)
		if update then
			updaters[holder] = update
			holder.Destroying:Connect(function()
				updaters[holder] = nil
			end)
		end
	end
	return holder
end

----------------------------------------------------------------
-- Live crosshair layer
----------------------------------------------------------------
local liveLayer = make("Frame", {
	Name = "LiveCrosshair",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 1,
	Parent = gui,
})

local equippedIndex = 1
local inventoryOpen = false
local liveHolder

local function refreshMouseIcon()
	local def = Crosshairs[equippedIndex]
	-- show the normal mouse while the inventory is open or when no crosshair is equipped
	UserInputService.MouseIconEnabled = inventoryOpen or def.Build == nil
end

local cards = {}

local function equip(index)
	equippedIndex = index
	if liveHolder then
		liveHolder:Destroy()
		liveHolder = nil
	end
	local def = Crosshairs[index]
	if def.Build then
		liveHolder = mount(def, liveLayer)
	end
	for i, card in ipairs(cards) do
		local selected = (i == index)
		card.Stroke.Color = selected and Color3.fromRGB(0, 255, 220) or Color3.fromRGB(70, 70, 80)
		card.Stroke.Thickness = selected and 2.5 or 1
		card.Tag.Text = selected and "EQUIPPED" or "Click to equip"
		card.Tag.TextColor3 = selected and Color3.fromRGB(0, 255, 220) or Color3.fromRGB(150, 150, 160)
	end
	refreshMouseIcon()
end

