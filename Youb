-- 1) Your Teal Shining Moving crosshair
table.insert(Crosshairs, {
	Name = "Teal Shining Ring",
	Build = function(holder)
		local ring = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		}, { corner(100) })

		local ringStroke = stroke(Color3.fromRGB(0, 255, 220), 2, 0.05)
		ringStroke.Parent = ring

		local glow = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(23, 23),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = ring.ZIndex - 1,
			Parent = holder,
		}, { corner(100) })

		local glowStroke = stroke(Color3.fromRGB(0, 255, 220), 3, 0.72)
		glowStroke.Parent = glow

		return function(elapsed)
			local pulse = (math.sin(elapsed * 3) + 1) / 2
			local shine = (math.sin(elapsed * 5) + 1) / 2

			local size = 15 + pulse * 3
			local glowSize = size + 8 + shine * 3

			local position = UDim2.new(
				0.5, math.sin(elapsed * 1.5) * 2,
				0.5, math.cos(elapsed * 1.8) * 2
			)

			ring.Position = position
			glow.Position = position
			ring.Size = UDim2.fromOffset(size, size)
			glow.Size = UDim2.fromOffset(glowSize, glowSize)

			ringStroke.Transparency = 0.05 + shine * 0.25
			ringStroke.Thickness = 1.8 + pulse * 0.7
			glowStroke.Transparency = 0.82 - shine * 0.3

			local c = Color3.fromRGB(0, 220 + math.floor(shine * 35), 210 + math.floor(shine * 45))
			ringStroke.Color = c
			glowStroke.Color = c
		end
	end,
})

